Configs: {
	ServerConfig: {
		DisplayName: Server

		Headers: {
			Teams: Teams
			BossFights: Boss Fights
			Wormholes: Wormholes
		}

		TeamToJoin: {
			Label: Team To Join
			Tooltip: Team assigned when a player joins the world. None disables auto-join. Players may change teams afterward.
		}

		BossFightLivesMode: {
			Label: Boss Fight Lives Mode
			Tooltip: Off = vanilla infinite respawns. PerPlayer = personal respawn budget. PerTeam = shared budget per team. Empty budget hard-locks respawn until the boss ends (like Better Multiplayer).
		}

		BossFightRespawns: {
			Label: Boss Fight Respawns
			Tooltip: Respawn budget. PerPlayer = each player. PerTeam (when Auto Team Size is off) = shared pool size. 0 = lock on first death.
		}

		BossFightLivesAutoTeamSize: {
			Label: Auto Team Size Lives
			Tooltip: PerTeam only. When on, shared pool equals players on that team at fight start. Unteamed players get a solo pool of 1. When off, uses Boss Fight Respawns.
		}

		FreeTeamWormhole: {
			Label: Free Team Wormhole
			Tooltip: Map-click teleport to teammates works without carrying Wormhole Potions. Real potions still exist and are not consumed while this is on.
		}

		BlockFreeWormholeDuringBoss: {
			Label: Block Free Wormhole During Boss Fights
			Tooltip: When enabled, free team wormholes are disabled while a boss is active. Real potions still work. Off by default.
		}
	}

	ClientConfig: {
		DisplayName: Client
		Headers.Spectate: Spectate

		SpectateOnDeath: {
			Label: Spectate On Death
			Tooltip: When you die in multiplayer, follow a living teammate (feature not implemented yet).
		}

		StopSpectateOnRespawn: {
			Label: Stop Spectate On Respawn
			Tooltip: Leave spectate mode when you respawn (feature not implemented yet).
		}
	}
}
