Keybinds: {
	PreviousPlayer.DisplayName: Spectate previous target
	NextPlayer.DisplayName: Spectate next target
	StopSpectating.DisplayName: Stop spectating
}

UI: {
	Death: {
		Slain: You were slain...
		OutOfLives: No lives left...
		SharedHealthWipe: Your team fell together...
		SpectatingIn: Spectating in {0}
		RespawnIn: Respawn in {0}
	}

	Spectate: {
		You: You
		Dead: "{0} is dead"
		Boss: "{0} (Boss)"
		OtherTeam: "{0} is on another team"
		Unavailable: Unavailable
	}
}

Configs: {
	ServerConfig: {
		DisplayName: Server

		Headers: {
			Teams: Teams
			BossFights: Boss Fights
			SharedHealth: Shared Health
			Wormholes: Wormholes
		}

		TeamToJoin: {
			Label: Team To Join
			Tooltip: Team assigned when a player joins the world. None disables auto-join. Players may change teams afterward.
		}

		BossFightLivesMode: {
			Label: Boss Fight Lives Mode
			Tooltip: Off = vanilla infinite respawns. PerPlayer = personal respawn budget (see Boss Fight Respawns). PerTeam = one shared pool per team equal to team size at fight start. Empty budget hard-locks until the boss ends.
		}

		BossFightRespawns: {
			Label: Boss Fight Respawns
			Tooltip: PerPlayer — how many times each player may respawn during a boss fight (0 = lock on first death). PerTeam — always team size at fight start (not editable). Hidden when mode is Off.
		}

		RespawnAtTeammateDuringBoss: {
			Label: Respawn At Teammate During Boss
			Tooltip: When on, players who die during a boss fight respawn beside a living teammate (spectate target if set, otherwise any living same-team player). No living teammate = vanilla bed/world spawn.
		}

		InstantRespawnOnBossEnd: {
			Label: Instant Respawn When Boss Ends
			Tooltip: When a boss fight ends (killed or despawned), dead players respawn immediately instead of finishing the vanilla countdown. Includes hard-locked players out of lives.
		}

		SharedHealthEnabled: {
			Label: Shared Team Health
			Tooltip: Challenge mode (off by default). Teamed players (1–5) share one HP pool. Everyone's life bar shows the pool. Pool empty = whole team dies. Independent of Boss Fight Lives. Unteamed players are unchanged.
		}

		SharedHealthBossesOnly: {
			Label: Bosses Only
			Tooltip: When on, shared health arms only during boss fights. When off, shared health stays active the whole session. Only applies while Shared Team Health is enabled.
		}

		SharedHealthMultiplier: {
			Label: Pool Size
			Tooltip: Team pool max as a multiplier of the sum of living members' max HP. 0.5 = half, 1.0 = full sum (default), 1.5 = one and a half. Joining teammates expands the pool. Only applies while Shared Team Health is enabled.
		}

		UnlimitedTeamTeleport: {
			Label: Unlimited Team Teleport
			Tooltip: Map-click teleport to teammates works without carrying Wormhole Potions. Real potions still exist and are not consumed while this is on.
		}

		BlockUnlimitedTeleportDuringBoss: {
			Label: Block Unlimited Teleport During Boss Fights
			Tooltip: When enabled, unlimited team teleport is disabled while a boss is active. Real potions still work. Off by default.
		}
	}

	ClientConfig: {
		DisplayName: Client
		Headers.Spectate: Spectate

		SpectateOnDeath: {
			Label: Spectate On Death
			Tooltip: After a short death intro, automatically spectate the next living teammate (then bosses if none). Hotkeys cycle teammates and bosses. Smooth camera on switch.
		}
	}

	TeamToJoinOption: {
		Tooltip: ""

		None: {
			Label: None
			Tooltip: ""
		}

		Red: {
			Label: Red
			Tooltip: ""
		}

		Green: {
			Label: Green
			Tooltip: ""
		}

		Blue: {
			Label: Blue
			Tooltip: ""
		}

		Yellow: {
			Label: Yellow
			Tooltip: ""
		}

		Pink: {
			Label: Pink
			Tooltip: ""
		}
	}

	BossFightLivesMode: {
		Tooltip: ""

		Off: {
			Label: Off
			Tooltip: ""
		}

		PerPlayer: {
			Label: Per Player
			Tooltip: ""
		}

		PerTeam: {
			Label: Per Team
			Tooltip: ""
		}
	}
}
