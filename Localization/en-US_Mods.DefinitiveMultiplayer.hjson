Keybinds: {
	PreviousPlayer.DisplayName: Spectate previous target
	NextPlayer.DisplayName: Spectate next target
	StopSpectating.DisplayName: Stop spectating
}

UI: {
	Death: {
		Slain: You were slain...
		OutOfLives: No lives left...
		SharedHealthWipe: Your team fell together...
		SpectatingIn: Spectating in {0}
		RespawnIn: Respawn in {0}
	}

	Spectate: {
		You: You
		Dead: "{0} is dead"
		Boss: "{0} (Boss)"
		OtherTeam: "{0} is on another team"
		Unavailable: Unavailable
	}
}

Configs: {
	ServerConfig: {
		DisplayName: Server Config

		Headers: {
			Teams: Teams
			BossFights: Boss Fights
			SharedHealth: Shared Health Mode
			Wormholes: Wormholes
		}

		TeamToJoin: {
			Label: "[i:TeamBlockWhite] Team To Join"
			Tooltip: Auto-assign this team when joining the world.
		}

		BossFightLivesMode: {
			Label: "[i:LifeCrystal] Boss Fight Lives Mode"
			Tooltip: How many times you can respawn during a boss fight.
		}

		BossFightRespawns: {
			Label: "[i:Tombstone] Boss Fight Respawns"
			Tooltip: Extra lives per player (0 = one life only).
		}

		RespawnAtTeammateDuringBoss: {
			Label: "[i:MagicMirror] Respawn At Teammate During Boss"
			Tooltip: Respawn next to a living teammate instead of at your bed.
		}

		BossFightStatsEnabled: {
			Label: "[i:DPSMeter] Boss Fight Stats Feed"
			Tooltip: Show live damage stats during boss fights.
		}

		SharedHealthEnabled: {
			Label: "[i:CrossNecklace] Shared Team Health"
			Tooltip: Your team shares one HP bar. Empty bar = whole team dies.
		}

		SharedHealthBossesOnly: {
			Label: "[i:SlimeCrown] Bosses Only"
			Tooltip: Shared HP only during boss fights.
		}

		SharedHealthMultiplier: {
			Label: "[i:LifeFruit] Team HP Multiplier"
			Tooltip: Size of the shared HP bar vs your team's combined max HP.
		}

		UnlimitedTeamTeleport: {
			Label: "[i:WormholePotion] Unlimited Team Teleport"
			Tooltip: Map-click teleport to teammates without Wormhole Potions.
		}

		BlockUnlimitedTeleportDuringBoss: {
			Label: "[i:PortalGun] Block Unlimited Teleport During Boss Fights"
			Tooltip: Disable free team teleport while a boss is alive.
		}
	}

	ClientConfig: {
		DisplayName: Client Config

		Headers: {
			Spectate: Spectate
			FightStats: Fight Stats
		}

		SpectateOnDeath: {
			Label: "[i:Binoculars] Spectate On Death"
			Tooltip: Auto-spectate teammates after you die.
		}

		ShowBossFightStats: {
			Label: "[i:Radar] Show Boss Fight Stats"
			Tooltip: Show the boss-fight stats feed on your screen.
		}
	}

	TeamToJoinOption: {
		Tooltip: ""

		None: {
			Label: None
			Tooltip: ""
		}

		Red: {
			Label: "[i:RedDye] Red"
			Tooltip: ""
		}

		Green: {
			Label: "[i:GreenDye] Green"
			Tooltip: ""
		}

		Blue: {
			Label: "[i:BlueDye] Blue"
			Tooltip: ""
		}

		Yellow: {
			Label: "[i:YellowDye] Yellow"
			Tooltip: ""
		}

		Pink: {
			Label: "[i:PinkDye] Pink"
			Tooltip: ""
		}
	}

	BossFightLivesMode: {
		Tooltip: ""

		Off: {
			Label: Off
			Tooltip: ""
		}

		PerPlayer: {
			Label: "[i:HealingPotion] Per Player"
			Tooltip: ""
		}

		PerTeam: {
			Label: "[i:SuperHealingPotion] Per Team"
			Tooltip: ""
		}
	}
}
