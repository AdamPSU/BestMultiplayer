Keybinds: {
	PreviousPlayer.DisplayName: Osserva bersaglio precedente
	NextPlayer.DisplayName: Osserva bersaglio successivo
	StopSpectating.DisplayName: Interrompi osservazione
}

UI: {
	Death: {
		Slain: Sei stato ucciso...
		OutOfLives: Vite esaurite...
		SharedHealthWipe: La vostra squadra è caduta insieme...
		SpectatingIn: Osservazione tra {0}
		RespawnIn: Rinascita tra {0}
	}

	Spectate: {
		You: Tu
		Dead: "{0} è morto"
		Boss: "{0} (Boss)"
		OtherTeam: "{0} è in un'altra squadra"
		Unavailable: Non disponibile
	}

	PlayerSwap.Countdown: Teleporting players in {0}
}

Configs: {
	ServerConfig: {
		DisplayName: Server Config

		Headers: {
			Teams: Teams
			BossLives: Boss Lives
			BossBalance: Boss Balance
			Respawn: Respawn
		}

		TeamToJoin: {
			Label: "[i:TeamBlockWhite] Auto-Join Team"
			Tooltip: Automatically put joining players on this team.
		}

		UnlimitedTeamTeleport: {
			Label: "[i:WormholePotion] Free Teammate Teleport"
			Tooltip: Map-click to teleport to teammates for free.
		}

		BlockUnlimitedTeleportDuringBoss: {
			Label: "[i:PortalGun] Block Free Teleport During Bosses"
			Tooltip: Disable free teammate teleport during boss fights.
		}

		SharedHealthEnabled: {
			Label: "[i:CrossNecklace] Shared Team Health Mode"
			Tooltip: One shared HP bar for the whole team.
		}

		SharedHealthBossesOnly: {
			Label: "[i:SuspiciousLookingEye] Only During Boss Fights"
			Tooltip: Shared HP only while a boss is alive.
		}

		SharedHealthMultiplier: {
			Label: "[i:LifeFruit] Team HP Multiplier"
			Tooltip: How large the shared HP bar is relative to the team.
		}

		PlayerSwapEnabled: {
			Label: "[i:TeleportationPotion] Player Swap Mode"
			Tooltip: Every so often, living teammates randomly switch places.
		}

		PlayerSwapIntervalMinutes: {
			Label: "[i:GoldWatch] Swap Every (Minutes)"
			Tooltip: How many minutes between teammate position swaps.
		}

		BossFightStatsEnabled: {
			Label: "[i:DPSMeter] Allow Boss Stats Feed"
			Tooltip: Allow the live boss stats overlay (players can still hide it).
		}

		RespawnBaseSeconds: {
			Label: "[i:Stopwatch] Respawn Wait (Seconds)"
			Tooltip: How long you wait to respawn by default.
		}

		RespawnTimer: {
			Label: "[i:FastClock] Timer Add-ons"
			Tooltip: Extra options that change respawn wait in bosses and events.
		}

		RespawnHealthPercent: {
			Label: "[i:LifeCrystal] Health on Respawn %"
			Tooltip: How full your health is when you respawn.
		}

		RespawnManaPercent: {
			Label: "[i:ManaCrystal] Mana on Respawn %"
			Tooltip: How full your mana is when you respawn.
		}

		RespawnAtTeammateDuringBoss: {
			Label: "[i:MagicMirror] Respawn Beside Teammate"
			Tooltip: During bosses, respawn next to the teammate you were watching.
		}

		BossFightLives: {
			Label: "[i:HealingPotion] Player Life Limit"
			Tooltip: Lives per player in a boss fight. Vanilla means no limit.
			Vanilla: Vanilla
		}

		BossFightTeamLives: {
			Label: "[i:SuperHealingPotion] Team Life Limit"
			Tooltip: Shared team lives in a boss fight. Vanilla means no limit.
			TeamSize: Team size
			Vanilla: Vanilla
		}

		BossFightDamageMultiplier: {
			Label: "[i:AvengerEmblem] Damage You Take"
			Tooltip: How hard bosses hit you. 1 is normal.
		}

		BossFightDamageDealtMultiplier: {
			Label: "[i:WarriorEmblem] Damage You Deal"
			Tooltip: How hard you hit bosses. 1 is normal.
		}

		BossFightBossHealthMultiplier: {
			Label: "[i:MechanicalEye] Boss Max Health"
			Tooltip: Boss health when they spawn. 1 is normal.
		}
	}

	RespawnTimerAdjustments: {
		ExtraSecondsPerPlayer: {
			Label: "[i:Mannequin] +Sec Per Extra Player"
			Tooltip: During bosses, add this many seconds for each extra player in the world.
		}

		BossMultiplier: {
			Label: "[i:SlimeCrown] Boss Multiplier"
			Tooltip: Make boss-fight respawns longer or shorter. 1 is unchanged.
		}

		EventMultiplier: {
			Label: "[i:BloodMoonStarter] Event Multiplier"
			Tooltip: Make respawns longer or shorter during events. 1 is unchanged.
		}

		ExtraSecondsPerBossDeath: {
			Label: "[i:Tombstone] +Sec Per Boss Death"
			Tooltip: During the same boss, each death makes your next wait this much longer.
		}

		// Tooltip: ""
	}

	ClientConfig: {
		DisplayName: Client Config
		Headers.Display: Display

		SpectateOnDeath: {
			Label: "[i:Binoculars] Spectate When Dead"
			Tooltip: Auto-spectate teammates after you die.
		}

		ShowBossFightStats: {
			Label: "[i:Radar] Show Boss Stats Feed"
			Tooltip: Show the boss stats overlay (if the server allows it).
		}
	}

	TeamToJoinOption: {
		Tooltip: ""

		None: {
			Label: None
			Tooltip: ""
		}

		Red: {
			Label: "[i:RedDye] Red"
			Tooltip: ""
		}

		Green: {
			Label: "[i:GreenDye] Green"
			Tooltip: ""
		}

		Blue: {
			Label: "[i:BlueDye] Blue"
			Tooltip: ""
		}

		Yellow: {
			Label: "[i:YellowDye] Yellow"
			Tooltip: ""
		}

		Pink: {
			Label: "[i:PinkDye] Pink"
			Tooltip: ""
		}
	}
}
