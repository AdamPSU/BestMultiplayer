	}
}

Configs: {
	ServerConfig: {
		DisplayName: Konfiguracja serwera

		Headers: {
			Teams: Drużyny
			BossFights: Walki z bossami
			SharedHealth: Tryb wspólnego zdrowia
			Wormholes: Eliksiry tunelu czasoprzestrzennego
		}

		TeamToJoin: {
			Label: "[i:TeamBlockWhite] Drużyna do dołączenia"
			Tooltip: Automatycznie przypisuje tę drużynę przy dołączaniu do świata.
		}

		BossFightLivesMode: {
			Label: "[i:LifeCrystal] Tryb żyć w walce z bossem"
			Tooltip: Ile razy możesz się odrodzić podczas walki z bossem.
		}

		BossFightRespawns: {
			Label: "[i:Tombstone] Odrodzenia w walce z bossem"
			Tooltip: Dodatkowe życia na gracza (0 = tylko jedno życie).
		}

		RespawnAtTeammateDuringBoss: {
			Label: "[i:MagicMirror] Odrodź się przy sojuszniku u bossa"
			Tooltip: Odrodzenie obok żywego sojusznika zamiast przy łóżku.
		}

		BossFightStatsEnabled: {
			Label: "[i:DPSMeter] Panel statystyk bossa"
			Tooltip: Pokazuje na żywo statystyki obrażeń podczas walk z bossami.
		}

		SharedHealthEnabled: {
			Label: "[i:CrossNecklace] Wspólne zdrowie drużyny"
			Tooltip: Drużyna dzieli jeden pasek PŻ. Pusty pasek = cała drużyna ginie.
		}

		SharedHealthBossesOnly: {
			Label: "[i:SlimeCrown] Tylko u bossów"
			Tooltip: Wspólne PŻ tylko podczas walk z bossami.
		}

		SharedHealthMultiplier: {
			Label: "[i:LifeFruit] Mnożnik PŻ drużyny"
			Tooltip: Rozmiar wspólnego paska PŻ względem łącznego maks. PŻ drużyny.
		}

		UnlimitedTeamTeleport: {
			Label: "[i:WormholePotion] Nielimitowana teleportacja drużynowa"
			Tooltip: Teleport do sojuszników kliknięciem na mapie bez eliksirów tunelu.
		}

		BlockUnlimitedTeleportDuringBoss: {
			Label: "[i:PortalGun] Blokuj nielimitowaną teleportację u bossów"
			Tooltip: Wyłącza darmową teleportację drużynową, gdy boss żyje.
		}
	}

