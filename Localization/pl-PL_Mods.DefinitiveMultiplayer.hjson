Keybinds: {
	PreviousPlayer.DisplayName: Obserwuj poprzedni cel
	NextPlayer.DisplayName: Obserwuj następny cel
	StopSpectating.DisplayName: Zakończ obserwację
}

UI: {
	Death: {
		Slain: Zostałeś pokonany...
		OutOfLives: Brak żyć...
		SharedHealthWipe: Wasza drużyna padła razem...
		SpectatingIn: Obserwacja za {0}
		RespawnIn: Odrodzenie za {0}
	}

	Spectate: {
		You: Ty
		Dead: "{0} nie żyje"
		Boss: "{0} (Boss)"
		OtherTeam: "{0} jest w innej drużynie"
		Unavailable: Niedostępne
	}
}

Configs: {
	ServerConfig: {
		DisplayName: Konfiguracja serwera

		Headers: {
			Teams: Drużyny
			BossFights: Walki z bossami
			SharedHealth: Wspólne zdrowie
		}

		TeamToJoin: {
			Label: "[i:TeamBlockWhite] Drużyna do dołączenia"
			Tooltip: Automatycznie przypisuje tę drużynę przy dołączaniu do świata.
		}

		BossFightLivesMode: {
			Label: "[i:LifeCrystal] Tryb żyć u bossa"
			Tooltip: Na gracza: osobne życia. Na drużynę: wspólna pula żyć.
		}

		BossFightLives: {
			Label: "[i:Tombstone] Życia gracza"
			Tooltip: Życia na gracza w walce z bossem (1 = bez odrodzeń). Maks. 5.
		}

		BossFightTeamLives: {
			Label: "[i:Tombstone] Życia drużyny"
			Tooltip: Wspólny limit żyć. 0 = rozmiar drużyny na starcie walki. 1–20 = stała wartość.
			TeamSize: Rozmiar drużyny
		}

		RespawnAtTeammateDuringBoss: {
			Label: "[i:MagicMirror] Odrodź się przy sojuszniku u bossa"
			Tooltip: Odrodzenie obok żywego sojusznika zamiast przy łóżku.
		}

		BossFightStatsEnabled: {
			Label: "[i:DPSMeter] Statystyki walki z bossem"
			Tooltip: Pokazuje na żywo statystyki obrażeń podczas walk z bossami.
		}

		BossFightDefenseMultiplier: {
			Label: "[i:EndurancePotion] Obrona w walce z bossem"
			Tooltip: Ułamek obrony gracza stosowany podczas walk z bossami. 1,0 = pełna obrona; 0,5 = połowa. Całe obrażenia nie-PvP, gdy boss żyje.
		}

		SharedHealthEnabled: {
			Label: "[i:CrossNecklace] Wspólne zdrowie drużyny"
			Tooltip: Drużyna dzieli jeden pasek PŻ. Pusty pasek = cała drużyna ginie.
		}

		SharedHealthBossesOnly: {
			Label: "[i:SlimeCrown] Tylko u bossów"
			Tooltip: Wspólne PŻ tylko podczas walk z bossami.
		}

		SharedHealthMultiplier: {
			Label: "[i:LifeFruit] Mnożnik PŻ drużyny"
			Tooltip: Fraction of combined team max HP (0.5–2, default 0.75).
		}

		UnlimitedTeamTeleport: {
			Label: "[i:WormholePotion] Nielimitowana teleportacja drużynowa"
			Tooltip: Teleport do sojuszników kliknięciem na mapie bez eliksirów tunelu.
		}

		BlockUnlimitedTeleportDuringBoss: {
			Label: "[i:PortalGun] Blokuj teleporty u bossów"
			Tooltip: Wyłącza darmową teleportację drużynową, gdy boss żyje.
		}
	}

	ClientConfig: {
		DisplayName: Konfiguracja klienta
