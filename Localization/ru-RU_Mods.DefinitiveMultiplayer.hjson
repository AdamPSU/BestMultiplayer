}

Configs: {
	ServerConfig: {
		DisplayName: Настройки сервера

		Headers: {
			Teams: Команды
			BossFights: Бои с боссами
			SharedHealth: Общее здоровье
		}

		TeamToJoin: {
			Label: "[i:TeamBlockWhite] Команда при входе"
			Tooltip: Автоматически назначать эту команду при входе в мир.
		}

		BossFightLivesMode: {
			Label: "[i:LifeCrystal] Режим жизней у босса"
			Tooltip: На игрока: у каждого свои жизни. На команду: общий запас жизней.
		}

		BossFightLives: {
			Label: "[i:Tombstone] Жизни игрока"
			Tooltip: Жизни на игрока в бою с боссом (1 = без возрождений). Макс. 5.
		}

		BossFightTeamLives: {
			Label: "[i:Tombstone] Жизни команды"
			Tooltip: Общий лимит жизней. 0 = размер команды в начале боя. 1–20 = фиксированное число.
			TeamSize: Размер команды
		}

		RespawnAtTeammateDuringBoss: {
			Label: "[i:MagicMirror] Возрождаться рядом с союзником у босса"
			Tooltip: Возрождаться рядом с живым союзником, а не у кровати.
		}

		BossFightStatsEnabled: {
			Label: "[i:DPSMeter] Лента статистики босса"
			Tooltip: Показывать живую статистику урона во время боёв с боссами.
		}

		SharedHealthEnabled: {
			Label: "[i:CrossNecklace] Общее здоровье команды"
			Tooltip: Команда делит одну полоску ОЗ. Пустая полоска = вся команда умирает.
		}

		SharedHealthBossesOnly: {
			Label: "[i:SlimeCrown] Только у боссов"
			Tooltip: Общее ОЗ только во время боёв с боссами.
		}

		SharedHealthMultiplier: {
			Label: "[i:LifeFruit] Множитель ОЗ команды"
			Tooltip: Размер общей полоски ОЗ относительно суммарного макс. ОЗ команды.
		}

		UnlimitedTeamTeleport: {
			Label: "[i:WormholePotion] Безлимитная командная телепортация"
			Tooltip: Телепорт к союзникам кликом по карте без зелий червоточины.
		}

		BlockUnlimitedTeleportDuringBoss: {
			Label: "[i:PortalGun] Блокировать телепорты у боссов"
			Tooltip: Отключает бесплатную командную телепортацию, пока жив босс.
		}
	}

	ClientConfig: {
