			FightStats: Боевая статистика
		}

		SpectateOnDeath: {
			Label: "[i:Binoculars] Наблюдение после смерти"
			Tooltip: Автоматически наблюдать за союзниками после смерти.
		}

		ShowBossFightStats: {
			Label: "[i:Radar] Показывать статистику босса"
			Tooltip: Показывать ленту статистики боя с боссом на экране.
		}
	}

