Keybinds: {
	PreviousPlayer.DisplayName: Наблюдать предыдущую цель
	NextPlayer.DisplayName: Наблюдать следующую цель
	StopSpectating.DisplayName: Прекратить наблюдение
}

UI: {
	Death: {
		Slain: Вы погибли...
		OutOfLives: Жизней не осталось...
		SharedHealthWipe: Ваша команда пала вместе...
		SpectatingIn: Наблюдение через {0}
		RespawnIn: Возрождение через {0}
	}

	Spectate: {
		You: Вы
		Dead: "{0} мёртв"
		Boss: "{0} (босс)"
		OtherTeam: "{0} в другой команде"
